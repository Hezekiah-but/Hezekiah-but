        -- === COMPLETELY FIXED DRAGGING SYSTEM ===
        local isDragging = false
        local dragStart = nil
        local startPos = nil

        local function updateDragInput(input)
            if not isDragging then return end
            
            local delta = input.Position - dragStart
            local newPos = startPos + UDim2.new(0, delta.X, 0, delta.Y)
            
            -- Enhanced boundary checking with current viewport
            local currentViewport = Camera.ViewportSize
            local frameSize = mainFrame.AbsoluteSize
            
            -- Safe boundaries - allow slight overflow but keep GUI accessible
            local minX = -frameSize.X * 0.7  -- 70% can be off-screen
            local maxX = currentViewport.X - frameSize.X * 0.3  -- Keep 30% on screen
            local minY = 0  -- Keep top visible
            local maxY = currentViewport.Y - frameSize.Y * 0.3  -- Keep 30% on screen
            
            local clampedX = math.clamp(newPos.X.Offset, minX, maxX)
            local clampedY = math.clamp(newPos.Y.Offset, minY, maxY)
            
            mainFrame.Position = UDim2.new(0, clampedX, 0, clampedY)
        end

        -- Enhanced drag detection with better visual feedback
        dragBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
                dragStart = input.Position
                startPos = UDim2.new(0, mainFrame.AbsolutePosition.X, 0, mainFrame.AbsolutePosition.Y)
                
                -- Enhanced visual feedback
                subtitleLabel.Text = "📍 DRAGGING... Release to drop"
                dragIndicator.BackgroundTransparency = 0.3
                TweenService:Create(dragIndicator, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {
                    BackgroundTransparency = 0.3
                }):Play()
                
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        isDragging = false
                        subtitleLabel.Text = "📍 DRAG THIS AREA TO MOVE • Configuration System • Data Persistence • Enhanced Features"
                        TweenService:Create(dragIndicator, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {
                            BackgroundTransparency = 0.8
                        }):Play()
                    end
                end)
            end
        end)

        -- Global input tracking for smooth dragging
        UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                updateDragInput(input)
            end
        end)

        -- === Enhanced Animations ===
        spawn(function()
            while frameGlow and frameGlow.Parent do
                TweenService:Create(frameGlow, TweenInfo.new(4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    ImageTransparency = 0.5,
                    Size = UDim2.new(1.15, 0, 1.15, 0)
                }):Play()
                wait(4)
                TweenService:Create(frameGlow, TweenInfo.new(4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    ImageTransparency = 0.9,
                    Size = UDim2.new(1.05, 0, 1.05, 0)
                }):Play()
                wait(4)
            end
        end)

        -- Auto reload on respawn
        player.CharacterAdded:Connect(function(char)
            wait(0.5)
            pcall(updateCharacter)
        end)

        -- Initialize
        pcall(updateCharacter)
        updateConfigStatus()

        -- === PERFECT CENTER SHOW WITH ENHANCED ENTRANCE ===
        wait(0.5)
        mainFrame.Visible = true
        
        -- Start small and grow to perfect center
        mainFrame.Size = UDim2.new(0, 0, 0, 0)
        mainFrame.Position = UDim2.new(0, centerX + guiWidth/2, 0, centerY + guiHeight/2)  -- Start from true center point
        
        -- Animate to final size and position
        TweenService:Create(mainFrame, TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, guiWidth, 0, guiHeight),
            Position = UDim2.new(0, centerX, 0, centerY)
        }):Play()
        
        createAdvancedNotification("🚀 Ultimate Checkpoint Hub V2.2", "Configuration System Loaded! Save, Load, Update & Delete Configs!", 5, "success", "⭐")
        
        -- Show configuration instructions
        spawn(function()
            wait(2)
            createAdvancedNotification("💡 Configuration System", "Save current checkpoints with custom names, then load them anytime!", 4, "info", "📋")
            wait(3)
            createAdvancedNotification("🔄 Data Persistence", "Your saved configurations will persist even after script reloads!", 4, "success", "💾")
        end)
    end)
end


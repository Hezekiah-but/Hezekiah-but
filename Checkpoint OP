        -- === Enhanced Movement Functions ===
        local teleportCooldown = false
        local function enhancedTeleport(data)
            if not root or not data or teleportCooldown then return end
            
            teleportCooldown = true
            
            pcall(function()
                root.Anchored = true
                humanoid.AutoRotate = false
                
                RunService.Heartbeat:Wait()
                
                root.CFrame = data.cframe
                Camera.CFrame = data.cameraCFrame
                
                if root:FindFirstChild("AssemblyLinearVelocity") then
                    root.AssemblyLinearVelocity = (data.state == Enum.HumanoidStateType.Freefall)
                        and Vector3.new(0, -10, 0)
                        or Vector3.new(0, 0, 0)
                end
                
                wait(0.05)
                humanoid:ChangeState(data.state)
                
                spawn(function()
                    wait(0.15)
                    if root and root.Parent then
                        root.Anchored = false
                        humanoid.AutoRotate = true
                    end
                    wait(0.1)
                    teleportCooldown = false
                end)
            end)

            createAdvancedNotification("⚡ Teleported", "To " .. (data.name or "checkpoint"), 1.5, "success", "📍")
        end

        local function enhancedFastMove(data)
            if not root or not data then return end

            local startPos = root.Position
            local endPos = data.cframe.Position
            local distance = (endPos - startPos).Magnitude
            
            -- Enhanced speed calculation with user control
            local userSpeed = CONFIG.fastMove.baseSpeed
            local moveSpeed = math.min(distance * userSpeed, CONFIG.fastMove.maxSpeed)
            local duration = distance / moveSpeed
            
            -- Ensure minimum duration for very fast speeds
            duration = math.max(duration, 0.1)

            local moveTween = TweenService:Create(
                root,
                TweenInfo.new(
                    duration,
                    CONFIG.fastMove.easingStyle,
                    CONFIG.fastMove.easingDirection
                ),
                {CFrame = data.cframe}
            )

            local cameraTween = TweenService:Create(
                Camera,
                TweenInfo.new(
                    duration,
                    CONFIG.fastMove.easingStyle,
                    CONFIG.fastMove.easingDirection
                ),
                {CFrame = data.cameraCFrame}
            )

            root.Anchored = true
            moveTween:Play()
            cameraTween:Play()

            moveTween.Completed:Connect(function()
                root.Anchored = false
                humanoid:ChangeState(data.state)
            end)

            createAdvancedNotification("🏃 Fast Moving", "To " .. (data.name or "checkpoint") .. " (Speed: " .. userSpeed .. "x)", 2, "info", "💨")
        end

        local function enhancedAIWalk(data)
            if not root or not humanoid or not data then return end

            createAdvancedNotification("🤖 AI Pathfinding", "Calculating optimal route...", 2, "info", "🗺️")
            
            createPathToDestination(root.Position, data.cframe.Position, function(waypoints)
                if waypoints and #waypoints > 0 then
                    createAdvancedNotification("🗺️ Route Found", "Walking with " .. #waypoints .. " waypoints", 2, "success", "✅")
                    aiWalkToDestination(humanoid, root, waypoints, CONFIG.aiWalk.walkSpeed)
                else
                    createAdvancedNotification("❌ No Path", "Could not find route to destination", 3, "error", "🚫")
                end
            end)
        end


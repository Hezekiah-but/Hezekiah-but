        local function saveCurrentConfiguration(configName)
            if configName == "" then
                createAdvancedNotification("❌ Invalid Name", "Please enter a configuration name", 2, "error", "📝")
                return
            end

            -- Check if name already exists
            for i, config in ipairs(configurationData) do
                if config.name == configName then
                    createAdvancedNotification("❌ Name Exists", "Configuration name already exists", 2, "error", "📝")
                    return
                end
            end

            -- Save current slot data
            local configData = {
                name = configName,
                timestamp = tick(),
                slots = {}
            }

            for i, slot in ipairs(slots) do
                if slot.data then
                    configData.slots[i] = {
                        name = slot.nameBox.Text,
                        cframe = {
                            position = {slot.data.cframe.Position.X, slot.data.cframe.Position.Y, slot.data.cframe.Position.Z},
                            rotation = {slot.data.cframe:ToEulerAnglesXYZ()}
                        },
                        cameraCFrame = {
                            position = {slot.data.cameraCFrame.Position.X, slot.data.cameraCFrame.Position.Y, slot.data.cameraCFrame.Position.Z},
                            rotation = {slot.data.cameraCFrame:ToEulerAnglesXYZ()}
                        },
                        state = slot.data.state.Name
                    }
                end
            end

            table.insert(configurationData, configData)
            saveDataToStorage()
            updateConfigStatus()
            
            createAdvancedNotification("💾 Configuration Saved", configName .. " has been saved successfully!", 3, "success", "✅")
        end

        local function loadConfiguration(configName)
            local targetConfig = nil
            for i, config in ipairs(configurationData) do
                if config.name == configName then
                    targetConfig = config
                    break
                end
            end

            if not targetConfig then
                createAdvancedNotification("❌ Config Not Found", configName .. " does not exist", 2, "error", "📂")
                return
            end

            -- Clear current slots
            for i, slot in ipairs(slots) do
                slot.data = nil
            end

            -- Load configuration data
            for slotIndex, slotData in pairs(targetConfig.slots) do
                if slots[slotIndex] then
                    local slot = slots[slotIndex]
                    slot.nameBox.Text = slotData.name
                    
                    -- Reconstruct CFrame from saved data
                    local pos = Vector3.new(slotData.cframe.position[1], slotData.cframe.position[2], slotData.cframe.position[3])
                    local rx, ry, rz = slotData.cframe.rotation[1], slotData.cframe.rotation[2], slotData.cframe.rotation[3]
                    local cframe = CFrame.new(pos) * CFrame.Angles(rx, ry, rz)
                    
                    local camPos = Vector3.new(slotData.cameraCFrame.position[1], slotData.cameraCFrame.position[2], slotData.cameraCFrame.position[3])
                    local camRx, camRy, camRz = slotData.cameraCFrame.rotation[1], slotData.cameraCFrame.rotation[2], slotData.cameraCFrame.rotation[3]
                    local camCFrame = CFrame.new(camPos) * CFrame.Angles(camRx, camRy, camRz)
                    
                    slot.data = {
                        cframe = cframe,
                        cameraCFrame = camCFrame,
                        state = Enum.HumanoidStateType[slotData.state],
                        name = slotData.name,
                        timestamp = targetConfig.timestamp
                    }
                    
                    -- Visual feedback
                    slot.slotStroke.Color = Color3.fromRGB(0, 255, 0)
                    TweenService:Create(slot.slotStroke, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
                        Color = Color3.fromRGB(60, 60, 60)
                    }):Play()
                end
            end

            createAdvancedNotification("📂 Configuration Loaded", configName .. " loaded successfully!", 3, "success", "✅")
        end


-- === REVOLUTIONARY CONFIGURATION MANAGER ===
function ConfigManager:new()
    local obj = setmetatable({}, ConfigManager)
    obj.configs = {}
    obj.currentConfig = "Default"
    obj:loadAllConfigurations()
    return obj
end

function ConfigManager:saveConfiguration(name, checkpointData, settings)
    if not name or name == "" then
        return false, "Configuration name cannot be empty"
    end
    
    if #name > 50 then
        return false, "Configuration name too long (max 50 characters)"
    end
    
    -- Count existing configurations
    local configCount = 0
    for _ in pairs(self.configs) do
        configCount = configCount + 1
    end
    
    if configCount >= CONFIG.security.maxConfigsPerUser and not self.configs[name] then
        return false, "Maximum configurations reached (" .. CONFIG.security.maxConfigsPerUser .. ")"
    end
    
    local configData = {
        name = name,
        checkpoints = checkpointData or {},
        settings = settings or table.clone(CONFIG),
        metadata = {
            created = tick(),
            modified = tick(),
            version = "3.0",
            checkpointCount = 0,
            author = player.Name,
            gameId = game.GameId
        }
    }
    
    -- Count checkpoints
    for _, cp in pairs(configData.checkpoints) do
        if cp then
            configData.metadata.checkpointCount = configData.metadata.checkpointCount + 1
        end
    end
    
    -- Encryption (if enabled)
    if CONFIG.features.encryptData then
        configData = self:encryptData(configData)
    end
    
    self.configs[name] = configData
    self:persistConfigurations()
    
    return true, "Configuration '" .. name .. "' saved successfully with " .. configData.metadata.checkpointCount .. " checkpoints"
end

function ConfigManager:loadConfiguration(name)
    if not self.configs[name] then
        return false, "Configuration '" .. name .. "' not found"
    end
    
    local configData = table.clone(self.configs[name])
    
    -- Decryption (if needed)
    if CONFIG.features.encryptData then
        configData = self:decryptData(configData)
    end
    
    -- Update metadata
    configData.metadata.modified = tick()
    configData.metadata.lastLoaded = tick()
    
    self.currentConfig = name
    currentConfigName = name
    
    return true, configData
end

function ConfigManager:deleteConfiguration(name)
    if name == "Default" then
        return false, "Cannot delete default configuration"
    end
    
    if not self.configs[name] then
        return false, "Configuration not found"
    end
    
    self.configs[name] = nil
    self:persistConfigurations()
    
    return true, "Configuration '" .. name .. "' deleted"
end

function ConfigManager:listConfigurations()
    local list = {}
    for name, config in pairs(self.configs) do
        local metadata = config.metadata or {}
        table.insert(list, {
            name = name,
            checkpointCount = metadata.checkpointCount or 0,
            created = metadata.created or 0,
            modified = metadata.modified or 0
        })
    end
    
    -- Sort by modified date (newest first)
    table.sort(list, function(a, b)
        return a.modified > b.modified
    end)
    
    return list
end

function ConfigManager:exportConfiguration(name)
    if not self.configs[name] then
        return nil, "Configuration not found"
    end
    
    local exportData = {
        name = name,
        data = self.configs[name],
        exportedBy = player.Name,
        exportedAt = tick(),
        version = "3.0"
    }
    
    local jsonData = HttpService:JSONEncode(exportData)
    return jsonData, "Configuration exported successfully"
end

function ConfigManager:importConfiguration(jsonData)
    local success, importData = pcall(function()
        return HttpService:JSONDecode(jsonData)
    end)
    
    if not success then
        return false, "Invalid configuration data"
    end
    
    if not importData.data or not importData.name then
        return false, "Corrupted configuration file"
    end
    
    local name = importData.name
    local suffix = ""
    local counter = 1
    
    -- Handle duplicate names
    while self.configs[name .. suffix] do
        suffix = "_" .. counter
        counter = counter + 1
    end
    
    local finalName = name .. suffix
    self.configs[finalName] = importData.data
    self:persistConfigurations()
    
    return true, "Configuration imported as '" .. finalName .. "'"
end

function ConfigManager:persistConfigurations()
    if not writefile then
        warn("File system not available - configurations will not persist")
        return
    end
    
    local success = pcall(function()
        local data = {
            configs = self.configs,
            currentConfig = self.currentConfig,
            version = "3.0",
            lastSaved = tick()
        }
        
        local jsonData = HttpService:JSONEncode(data)
        writefile(STORAGE_KEY .. ".json", jsonData)
    end)
    
    if not success then
        warn("Failed to save configurations")
    end
end

function ConfigManager:loadAllConfigurations()
    if not readfile then
        return
    end
    
    local success = pcall(function()
        local jsonData = readfile(STORAGE_KEY .. ".json")
        local data = HttpService:JSONDecode(jsonData)
        
        if data and data.configs then
            self.configs = data.configs
            self.currentConfig = data.currentConfig or "Default"
            currentConfigName = self.currentConfig
        end
    end)
    
    if not success then
        -- Create default configuration
        self.configs["Default"] = {
            name = "Default",
            checkpoints = {},
            settings = table.clone(CONFIG),
            metadata = {
                created = tick(),
                modified = tick(),
                version = "3.0",
                checkpointCount = 0,
                author = player.Name,
                gameId = game.GameId
            }
        }
    end
end


        end

        local function stopAutoplay()
            CONFIG.autoplay.isPlaying = false
            if CONFIG.autoplay.connection then
                CONFIG.autoplay.connection:Disconnect()
                CONFIG.autoplay.connection = nil
            end
            autoplayBtn.Text = "▶️ START AUTOPLAY"
            autoplayBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
            autoplayStatus.Text = "🔄 Status: Ready for epic adventures!"
            updateProgressBar(0, 1)
            createAdvancedNotification("⏹️ Autoplay Stopped", "Autoplay sequence terminated by user", 2, "warning", "✋")
        end

        local function startEnhancedAutoplay()
            if CONFIG.autoplay.isPlaying then
                stopAutoplay()
                return
            end
            
            -- Enhanced slot detection
            local savedSlots = {}
            for i, slot in ipairs(slots) do
                if slot.data then
                    table.insert(savedSlots, {
                        index = i, 
                        slot = slot,
                        priority = slot.data.timestamp or 0
                    })
                end
            end
            
            if #savedSlots == 0 then
                createAdvancedNotification("❌ No Saved Checkpoints", "Please save some checkpoints first!", 3, "error", "💾")
                return
            end
            
            -- Enhanced sorting options
            if CONFIG.autoplay.shuffleOrder then
                -- Shuffle slots for random order
                for i = #savedSlots, 2, -1 do
                    local j = math.random(i)
                    savedSlots[i], savedSlots[j] = savedSlots[j], savedSlots[i]
                end
            else
                -- Sort by index (default)
                table.sort(savedSlots, function(a, b) return a.index < b.index end)
            end
            
            CONFIG.autoplay.isPlaying = true
            CONFIG.autoplay.currentSlot = 1
            autoplayBtn.Text = "⏹️ STOP AUTOPLAY"
            autoplayBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            
            createAdvancedNotification("🎮 Autoplay Started", "Processing " .. #savedSlots .. " checkpoints with " .. CONFIG.autoplay.repeatCount .. " repeats each", 4, "success", "▶️")
            
            local totalActions = #savedSlots * CONFIG.autoplay.repeatCount
            local currentAction = 0
            local startTime = tick()
            
            local function processNextSlot()
                if not CONFIG.autoplay.isPlaying then return end
                
                if CONFIG.autoplay.currentSlot > #savedSlots then
                    -- Enhanced completion handling
                    CONFIG.autoplay.isPlaying = false
                    autoplayBtn.Text = "▶️ START AUTOPLAY"
                    autoplayBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
                    
                    local totalTime = tick() - startTime
                    autoplayStatus.Text = "✅ Completed in " .. math.floor(totalTime) .. " seconds!"
                    updateProgressBar(totalActions, totalActions)
                    
                    createAdvancedNotification("✅ Autoplay Complete!", "All " .. #savedSlots .. " checkpoints visited " .. CONFIG.autoplay.repeatCount .. " times in " .. math.floor(totalTime) .. "s", 5, "success", "🎉")
                    
                    -- Auto-restart if enabled
                    if CONFIG.autoplay.autoRestart then
                        task.wait(2)
                        startEnhancedAutoplay()
                    end
                    return
                end
                
                local currentSlotData = savedSlots[CONFIG.autoplay.currentSlot]
                autoplayStatus.Text = "🎯 Processing " .. currentSlotData.slot.nameBox.Text .. " (" .. CONFIG.autoplay.currentSlot .. "/" .. #savedSlots .. ")"
                
                -- Enhanced action execution with error handling
                local actionCount = 0
                local function executeAction()
                    if not CONFIG.autoplay.isPlaying then return end
                    
                    actionCount = actionCount + 1
                    currentAction = currentAction + 1
                    
                    updateProgressBar(currentAction, totalActions)
                    
                    -- Enhanced error handling
                    local success = pcall(function()
                        if currentMode == 1 then
                            enhancedTeleport(currentSlotData.slot.data)
                        elseif currentMode == 2 then
                            enhancedFastMove(currentSlotData.slot.data)
                        elseif currentMode == 3 then
                            enhancedAIWalk(currentSlotData.slot.data)
                        end
                    end)
                    
                    if not success and CONFIG.autoplay.pauseOnFail then
                        createAdvancedNotification("⚠️ Action Failed", "Pausing autoplay due to error", 3, "warning", "⏸️")
                        stopAutoplay()
                        return
                    end
                    
                    if actionCount < CONFIG.autoplay.repeatCount then
                        -- Schedule next repetition
                        CONFIG.autoplay.connection = task.spawn(function()
                            task.wait(CONFIG.autoplay.delay)
                            executeAction()
                        end)
                    else
                        -- Move to next slot
                        CONFIG.autoplay.currentSlot = CONFIG.autoplay.currentSlot + 1
                        CONFIG.autoplay.connection = task.spawn(function()
                            task.wait(CONFIG.autoplay.delay)
                            processNextSlot()
                        end)
                    end
                end
                
                executeAction()
            end
            
            processNextSlot()
        end


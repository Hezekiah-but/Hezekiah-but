                else
                    createAdvancedNotification("❌ No Path Found", "AI could not calculate route to destination", 3, "error", "🚫")
                end
            end)
        end

        -- === ENHANCED AUTOPLAY SYSTEM ===
        local function updateProgressBar(current, total)
            local progress = math.min(current / math.max(total, 1), 1)
            TweenService:Create(progressBar, TweenInfo.new(0.3 * CONFIG.ui.animationSpeed, Enum.EasingStyle.Quart), {

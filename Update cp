        -- === ENHANCED MOVEMENT FUNCTIONS ===
        local teleportCooldown = false
        local function enhancedTeleport(data)
            if not root or not data or teleportCooldown then return end
            
            teleportCooldown = true
            
            pcall(function()
                -- Enhanced teleportation with safety checks
                root.Anchored = true
                humanoid.AutoRotate = false
                
                RunService.Heartbeat:Wait()
                
                -- Smooth teleportation
                if CONFIG.features.smoothTransitions then
                    local startCFrame = root.CFrame
                    local steps = 5
                    
                    for i = 1, steps do
                        local alpha = i / steps
                        root.CFrame = startCFrame:Lerp(data.cframe, alpha)
                        Camera.CFrame = Camera.CFrame:Lerp(data.cameraCFrame, alpha)
                        task.wait(0.01)
                    end
                else
                    root.CFrame = data.cframe
                    Camera.CFrame = data.cameraCFrame
                end
                
                -- Enhanced velocity handling
                if root:FindFirstChild("AssemblyLinearVelocity") then
                    root.AssemblyLinearVelocity = (data.state == Enum.HumanoidStateType.Freefall)
                        and Vector3.new(0, -15, 0)
                        or Vector3.new(0, 0, 0)
                end
                
                task.wait(0.05)
                humanoid:ChangeState(data.state)
                
                task.spawn(function()
                    task.wait(0.2)
                    if root and root.Parent then
                        root.Anchored = false
                        humanoid.AutoRotate = true
                    end
                    task.wait(0.1)
                    teleportCooldown = false
                end)
            end)

            createAdvancedNotification("⚡ Teleported Successfully", "Arrived at " .. (data.name or "checkpoint"), 2, "success", "📍")
        end

        local function enhancedFastMove(data)
            if not root or not data then return end

            local startPos = root.Position
            local endPos = data.cframe.Position
            local distance = (endPos - startPos).Magnitude
            
            -- Enhanced speed calculation with better physics
            local userSpeed = CONFIG.fastMove.baseSpeed
            local acceleration = CONFIG.fastMove.acceleration
            local smoothness = CONFIG.fastMove.smoothness
            
            local moveSpeed = math.min(distance * userSpeed * acceleration, CONFIG.fastMove.maxSpeed)
            local duration = (distance / moveSpeed) * smoothness
            
            duration = math.max(duration, 0.1)

            -- Enhanced tweening with better easing
            local moveTween = TweenService:Create(
                root,
                TweenInfo.new(
                    duration,
                    CONFIG.fastMove.easingStyle,
                    CONFIG.fastMove.easingDirection
                ),
                {CFrame = data.cframe}
            )

            local cameraTween = TweenService:Create(
                Camera,
                TweenInfo.new(
                    duration,
                    CONFIG.fastMove.easingStyle,
                    CONFIG.fastMove.easingDirection
                ),
                {CFrame = data.cameraCFrame}
            )

            root.Anchored = true
            moveTween:Play()
            cameraTween:Play()

            moveTween.Completed:Connect(function()
                root.Anchored = false
                humanoid:ChangeState(data.state)
            end)

            createAdvancedNotification("🏃 Fast Moving", "To " .. (data.name or "checkpoint") .. " at " .. math.floor(moveSpeed) .. " speed", 2, "info", "💨")
        end

        local function enhancedAIWalk(data)
            if not root or not humanoid or not data then return end

            createAdvancedNotification("🤖 AI Pathfinding", "Calculating optimal route with advanced algorithms...", 2, "info", "🗺️")
            
            createPathToDestination(root.Position, data.cframe.Position, function(waypoints)

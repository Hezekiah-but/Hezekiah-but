        -- === ENHANCED CONFIGURATION EVENT HANDLERS ===
        saveConfigBtn.MouseButton1Click:Connect(saveCurrentConfiguration)
        loadConfigBtn.MouseButton1Click:Connect(showConfigurationDropdown)
        dropdownBtn.MouseButton1Click:Connect(showConfigurationDropdown)
        deleteConfigBtn.MouseButton1Click:Connect(deleteCurrentConfiguration)
        exportImportBtn.MouseButton1Click:Connect(function()
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                importConfiguration()
            else
                exportCurrentConfiguration()
            end
        end)

        -- Configuration name input handler
        configNameInput.FocusLost:Connect(function()
            if configNameInput.Text ~= "" then
                loadConfigurationByName(configNameInput.Text)
            end
        end)

        -- === ENHANCED BUTTON HANDLERS ===
        for i, slot in ipairs(slots) do
            slot.saveBtn.MouseButton1Click:Connect(function()
                if not root or not humanoid then
                    createAdvancedNotification("❌ Character Missing", "Please reload character first", 3, "error", "👤")
                    return
                end
                
                -- Enhanced position validation
                local position = root.Position
                if position.Magnitude > 100000 then
                    createAdvancedNotification("❌ Invalid Position", "Position too extreme for safe saving", 3, "error", "📍")
                    return
                end
                
                -- Enhanced data capture
                local data = {
                    cframe = root.CFrame,
                    cameraCFrame = Camera.CFrame,
                    state = humanoid:GetState(),
                    name = slot.nameBox.Text,
                    timestamp = tick(),
                    gameId = game.GameId,
                    placeId = game.PlaceId
                }
                slot.data = data
                
                -- Enhanced visual feedback with animation
                slot.slotStroke.Color = Color3.fromRGB(0, 255, 100)
                slot.slotStroke.Thickness = 3
                
                TweenService:Create(slot.slotStroke, TweenInfo.new(1.0, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Color = Color3.fromRGB(60, 60, 80),
                    Thickness = 1
                }):Play()
                
                -- Enhanced success notification
                createAdvancedNotification("💾 Checkpoint Saved Successfully!", slot.nameBox.Text .. " saved to slot " .. i, 3, "success", "✅")
                
                -- Auto-save configuration if enabled
                if CONFIG.features.autoSave then
                    saveCurrentConfiguration()
                end
            end)

            slot.actionBtn.MouseButton1Click:Connect(function()
                if slot.data then
                    -- Enhanced action execution with better feedback
                    local actionName = modes[currentMode].name
                    createAdvancedNotification("🎯 Executing Action", actionName .. " to " .. slot.nameBox.Text, 1.5, "info", modes[currentMode].icon)
                    
                    if currentMode == 1 then
                        enhancedTeleport(slot.data)
                    elseif currentMode == 2 then
                        enhancedFastMove(slot.data)
                    elseif currentMode == 3 then
                        enhancedAIWalk(slot.data)
                    end
                else
                    createAdvancedNotification("❌ Empty Slot", "Please save a checkpoint to slot " .. i .. " first!", 2, "warning", "💾")
                end
            end)
        end

        -- === ENHANCED UTILITY FUNCTIONS ===
        reloadBtn.MouseButton1Click:Connect(function()
            createAdvancedNotification("🔄 Reloading Character", "Refreshing character data...", 2, "info", "👤")
            pcall(updateCharacter)
        end)

        clearAllBtn.MouseButton1Click:Connect(function()
            -- Enhanced confirmation system
            if CONFIG.security.requireConfirmation then
                createAdvancedNotification("⚠️ Confirm Action", "Hold SHIFT and click again to clear all slots", 4, "warning", "🗑️")
                if not UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                    return
                end
            end
            
            local count = 0
            for i, slot in ipairs(slots) do
                if slot.data then
                    slot.data = nil
                    slot.slotStroke.Color = Color3.fromRGB(60, 60, 80)
                    count = count + 1
                end
            end
            createAdvancedNotification("🗑️ Slots Cleared", "Cleared " .. count .. " checkpoint slots successfully", 3, "warning", "🧹")
            
            -- Auto-save if enabled
            if CONFIG.features.autoSave then
                saveCurrentConfiguration()
            end
        end)

        settingsBtn.MouseButton1Click:Connect(function()
            createAdvancedNotification("⚙️ Settings Panel", "Advanced settings coming in next update!", 3, "info", "🔧")
            
            -- Show current settings in console
            print("=== CURRENT CONFIGURATION SETTINGS ===")
            print("AI Walk Speed:", CONFIG.aiWalk.walkSpeed)
            print("Fast Move Speed:", CONFIG.fastMove.baseSpeed)
            print("Autoplay Delay:", CONFIG.autoplay.delay)
            print("UI Theme:", CONFIG.ui.theme)
            print("Sound Effects:", CONFIG.features.soundEffects)
            print("Auto Save:", CONFIG.features.autoSave)
        end)

        about

-- === ENHANCED AI PATHFINDING FUNCTIONS ===
local function createPathToDestination(startPos, endPos, callback)
    local path = PathfindingService:CreatePath({
        AgentRadius = CONFIG.aiWalk.agentRadius,
        AgentHeight = CONFIG.aiWalk.agentHeight,
        AgentCanJump = CONFIG.aiWalk.agentCanJump,
        WaypointSpacing = CONFIG.aiWalk.waypointSpacing,
        Costs = CONFIG.aiWalk.costs
    })
    
    local success, errorMessage = pcall(function()
        path:ComputeAsync(startPos, endPos)
    end)
    
    if success and path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        
        -- Enhanced pathfinding with distance check
        local totalDistance = 0
        for i = 2, #waypoints do
            totalDistance = totalDistance + (waypoints[i].Position - waypoints[i-1].Position).Magnitude
        end
        
        if totalDistance > CONFIG.aiWalk.maxDistance then
            createAdvancedNotification("⚠️ Path Too Long", "Distance: " .. math.floor(totalDistance) .. " (max: " .. CONFIG.aiWalk.maxDistance .. ")", 3, "warning", "📏")
            return
        end
        
        callback(waypoints)
    else
        -- Enhanced fallback with validation
        local distance = (endPos - startPos).Magnitude
        if distance > CONFIG.aiWalk.maxDistance then
            createAdvancedNotification("❌ Destination Too Far", "Distance: " .. math.floor(distance), 3, "error", "🚫")
            return
        end
        
        local directWaypoints = {
            {Position = startPos, Action = Enum.PathWaypointAction.Walk},
            {Position = endPos, Action = Enum.PathWaypointAction.Walk}
        }
        callback(directWaypoints)
    end
end

local function aiWalkToDestination(humanoid, humanoidRootPart, waypoints, walkSpeed)
    if not waypoints or #waypoints == 0 then return end
    
    -- Enhanced AI walking with better controls
    humanoid.WalkSpeed = walkSpeed or CONFIG.aiWalk.walkSpeed
    humanoid.JumpPower = CONFIG.aiWalk.jumpPower
    
    local currentWaypointIndex = 1
    local connection
    local startTime = tick()
    
    local function moveToNextWaypoint()
        -- Timeout check
        if tick() - startTime > CONFIG.aiWalk.timeoutDuration then
            if connection then connection:Disconnect() end
            createAdvancedNotification("⏰ AI Walk Timeout", "Navigation took too long", 3, "warning", "⏰")
            return
        end
        
        if currentWaypointIndex > #waypoints then
            if connection then connection:Disconnect() end
            createAdvancedNotification("🚶 AI Walk Complete", "Successfully arrived at destination!", 3, "success", "✅")
            return
        end
        
        local waypoint = waypoints[currentWaypointIndex]
        
        -- Enhanced jump handling
        if waypoint.Action == Enum.PathWaypointAction.Jump then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            task.wait(0.3) -- Wait for jump to complete
        end
        
        -- Move to waypoint with progress tracking
        humanoid:MoveTo(waypoint.Position)
        currentWaypointIndex = currentWaypointIndex + 1
        
        -- Show progress for long paths
        if #waypoints > 5 then
            local progress = math.floor((currentWaypointIndex-1) / #waypoints * 100)
            createAdvancedNotification("🗺️ AI Navigation", "Progress: " .. progress .. "% (" .. currentWaypointIndex-1 .. "/" .. #waypoints .. ")", 1, "info", "🤖")
        end
    end
    
    -- Start moving
    moveToNextWaypoint()
    
    -- Enhanced movement tracking
    connection = humanoid.MoveToFinished:Connect(function(reached)
        if reached then
            moveToNextWaypoint()
        else
            -- Enhanced failure handling
            local retryCount = 0
            local maxRetries = 3
            
            while retryCount < maxRetries and not reached do
                retryCount = retryCount + 1
                createAdvancedNotification("🔄 AI Retry", "Attempt " .. retryCount .. "/" .. maxRetries, 1, "warning", "⚠️")
                
                task.wait(0.5)
                humanoid:MoveTo(waypoints[math.max(1, currentWaypointIndex-1)].Position)
                
                -- Check if reached after retry
                task.wait(2)
                local currentPos = humanoidRootPart.Position
                local targetPos = waypoints[math.max(1, currentWaypointIndex-1)].Position
                reached = (currentPos - targetPos).Magnitude < 10
            end
            
            if not reached then
                createAdvancedNotification("❌ AI Path Blocked", "Skipping to next waypoint", 2, "error", "🚫")
            end
            
            currentWaypointIndex = currentWaypointIndex + 1
            moveToNextWaypoint()
        end
    end)
end


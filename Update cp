        -- Save current configuration
        local function saveCurrentConfiguration()
            local name = configNameInput.Text
            if not name or name == "" then
                createAdvancedNotification("❌ Invalid Name", "Please enter a configuration name", 3, "error", "📝")
                return
            end
            
            -- Collect current checkpoint data
            local checkpointData = {}
            for i, slot in ipairs(slots) do
                if slot.data then
                    checkpointData[i] = {
                        name = slot.nameBox.Text,
                        cframe = {
                            position = {slot.data.cframe.Position.X, slot.data.cframe.Position.Y, slot.data.cframe.Position.Z},
                            rotation = {slot.data.cframe:ToEulerAnglesXYZ()}
                        },
                        cameraCFrame = {
                            position = {slot.data.cameraCFrame.Position.X, slot.data.cameraCFrame.Position.Y, slot.data.cameraCFrame.Position.Z},
                            rotation = {slot.data.cameraCFrame:ToEulerAnglesXYZ()}
                        },
                        state = tostring(slot.data.state),
                        timestamp = slot.data.timestamp
                    }
                end
            end
            
            local success, message = configManager:saveConfiguration(name, checkpointData, CONFIG)
            
            if success then
                currentConfigName = name
                loadConfigBtn.Text = "📂 " .. name
                configStatus.Text = "📊 Saved: " .. name .. " • " .. message
                createAdvancedNotification("💾 Configuration Saved!", name .. " with " .. (#checkpointData) .. " checkpoints", 4, "config", "⭐")
            else
                createAdvancedNotification("❌ Save Failed", message, 3, "error", "💾")
            end
        end
        
        -- Load configuration
        local function loadConfigurationByName(name)
            local success, configData = configManager:loadConfiguration(name)
            
            if not success then
                createAdvancedNotification("❌ Load Failed", configData, 3, "error", "📂")
                return
            end
            
            -- Clear current slots
            for i, slot in ipairs(slots) do
                slot.data = nil
                slot.slotStroke.Color = Color3.fromRGB(60, 60, 80)
            end
            
            -- Load checkpoint data
            local loadedCount = 0
            if configData.checkpoints then
                for i, cpData in pairs(configData.checkpoints) do
                    if slots[i] and cpData then
                        slots[i].nameBox.Text = cpData.name or ("Checkpoint " .. i)
                        
                        -- Reconstruct CFrame data
                        local pos = Vector3.new(unpack(cpData.cframe.position))
                        local rot = Vector3.new(unpack(cpData.cframe.rotation))
                        local cframe = CFrame.new(pos) * CFrame.fromEulerAnglesXYZ(rot.X, rot.Y, rot.Z)
                        
                        local camPos = Vector3.new(unpack(cpData.cameraCFrame.position))
                        local camRot = Vector3.new(unpack(cpData.cameraCFrame.rotation))
                        local camCFrame = CFrame.new(camPos) * CFrame.fromEulerAnglesXYZ(camRot.X, camRot.Y, camRot.Z)
                        
                        slots[i].data = {
                            cframe = cframe,
                            cameraCFrame = camCFrame,
                            state = Enum.HumanoidStateType[cpData.state] or Enum.HumanoidStateType.Running,
                            name = cpData.name,
                            timestamp = cpData.timestamp
                        }
                        
                        -- Visual feedback
                        slots[i].slotStroke.Color = Color3.fromRGB(0, 255, 100)
                        loadedCount = loadedCount + 1
                    end
                end
            end
            
            -- Load settings if available
            if configData.settings then
                CONFIG = configData.settings
                aiSpeedInput.Text = tostring(CONFIG.aiWalk.walkSpeed)
                fastSpeedInput.Text = tostring(CONFIG.fastMove.baseSpeed)
                autoplayDelayInput.Text = tostring(CONFIG.autoplay.delay)
                repeatCountInput.Text = tostring(CONFIG.autoplay.repeatCount)
            end
            
            currentConfigName = name
            loadConfigBtn.Text = "📂 " .. name
            configStatus.Text = "📊 Loaded: " .. name .. " • " .. loadedCount .. " checkpoints restored"
            createAdvancedNotification("📂 Configuration Loaded!", name .. " with " .. loadedCount .. " checkpoints", 4, "config", "✨")
        end
        
